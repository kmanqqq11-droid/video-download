PORT=3000
# Path to the yt-dlp binary (default: found on PATH)
YTDLP_PATH=yt-dlp
# Optional: Netscape-format cookies file (needed for some age/login restricted content)
YTDLP_COOKIES_FILE=
# Limits
MAX_CONCURRENT_JOBS=2
MAX_DURATION_SECONDS=3600
MAX_FILESIZE=500M
JOB_TTL_MINUTES=10
# Requests per minute per IP on /api
RATE_LIMIT_PER_MINUTE=30
# PIN protection (recommended if reachable from the internet). Use 6+ digits. Empty = no login.
APP_PIN=123
# Optional: keeps logins valid across server restarts (any long random string)
SESSION_SECRET=
# Optional: extra allowed origins for the standalone HTML file, comma separated
CORS_ORIGINS=
